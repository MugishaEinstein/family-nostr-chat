# Copy this file to .env on the Ubuntu server. Never commit the resulting .env file.
# Point both DNS A records at the Ubuntu server that already runs Nginx Proxy Manager.
APP_DOMAIN=chat.nostr.africa
RELAY_DOMAIN=relay.chat.nostr.africa

# Confirm this network with: docker network ls
NPM_NETWORK=nginx-proxy-manager_default

# Generate two independent values using: openssl rand -hex 32
# They protect Family Chat's local MariaDB service and must remain private.
DB_PASSWORD=replace-with-a-long-random-database-password
DB_ROOT_PASSWORD=replace-with-a-different-long-random-root-password
