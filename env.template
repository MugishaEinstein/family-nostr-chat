# Copy this file to .env on the Ubuntu server. Never commit the resulting .env file.
# DNS must point both names to this Ubuntu server before you start the stack.
# The NPM stack must be attached to NPM_NETWORK. Confirm its actual name with `docker network ls`.
APP_DOMAIN=chat.example.com
RELAY_DOMAIN=relay.example.com
NPM_NETWORK=npm_default

# Comma-separated 64-character hexadecimal public keys for everyone permitted to write.
# Add your own pubkey first. The app reveals it as an npub; convert it to hex or ask
# the family member to share hex when adding the key to this server allowlist.
FAMILY_PUBKEYS=replace-with-first-64-character-hex-pubkey
