# Copy this file to .env on the Ubuntu server. Never commit the resulting .env file.
# DNS must point both names to this Ubuntu server before you start the stack.
# The NPM stack must be attached to NPM_NETWORK. Confirm its actual name with `docker network ls`.
APP_DOMAIN=chat.example.com
RELAY_DOMAIN=relay.example.com
NPM_NETWORK=npm_default

# Choose a long, private family invite code. Every new family device enters it once;
# its browser key is then enrolled automatically. Do not share this code publicly.
FAMILY_INVITE_CODE=replace-with-a-long-private-family-invite-code

# Optional migration support only: previously allowlisted hexadecimal keys are accepted
# and recorded as members on first use. New members do not need to be added here.
FAMILY_PUBKEYS=
