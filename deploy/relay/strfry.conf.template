db = "/app/strfry-db/"

events {
  maxEventSize = 65536
  rejectEventsNewerThanSeconds = 900
  rejectEventsOlderThanSeconds = 94608000
}

relay {
  bind = "0.0.0.0"
  port = 7777
  maxWebsocketPayloadSize = 131072
  autoPingSeconds = 55
  enableTcpKeepalive = true

  auth {
    enabled = true
    serviceUrl = "__RELAY_URL__"
    restrictedReadKinds = "1059,28934"
    restrictReadToInvolvedPubkey = true
  }

  info {
    name = "Family Chat private relay"
    description = "Private relay for an enrolled family group."
    contact = "Family administrator"
  }

  writePolicy {
    plugin = "python3 /app/family-allowlist.py"
    timeoutSeconds = 5
  }

  compression {
    enabled = true
    slidingWindow = true
  }
}
